<!--
  HIE SIEM — Network-Level Anomaly Detection Rules
  Sources: AWS VPC Flow Logs, Azure NSG Flow Logs (via Logstash ECS)
  Rule ID range: 100700-100899
-->
<group name="hie,network,anomaly,">

  <!-- DNS tunneling — unusually large DNS queries -->
  <rule id="100701" level="12">
    <if_group>syslog</if_group>
    <match>dns.*query|named.*query</match>
    <field name="data.query_length" type="pcre2">^[5-9]\d{2}$|^\d{4,}$</field>
    <description>Network Anomaly: Oversized DNS query ($(data.query_length) bytes) — possible DNS tunneling from $(data.srcip)</description>
    <mitre><id>T1071.004</id></mitre>
    <group>dns_tunneling,data_exfiltration,network_anomaly,</group>
  </rule>

  <!-- Port scanning detected via high deny rate -->
  <rule id="100710" level="11">
    <if_group>firewall</if_group>
    <field name="event.action">deny|reject|drop</field>
    <same_source_ip/>
    <frequency>20</frequency>
    <timeframe>60</timeframe>
    <description>Network Anomaly: Port scan detected — $(frequency) denied connections in $(timeframe)s from $(data.srcip)</description>
    <mitre><id>T1046</id></mitre>
    <group>port_scan,network_anomaly,</group>
  </rule>

  <!-- Large outbound data transfer — potential exfiltration -->
  <rule id="100720" level="13">
    <if_group>firewall</if_group>
    <field name="network.bytes" type="pcre2">^[5-9]\d{8}$|^\d{9,}$</field>
    <field name="event.action">allow</field>
    <field name="source.ip" type="pcre2">10\.|172\.(1[6-9]|2[0-9]|3[01])\.|192\.168\.</field>
    <description>Network Anomaly: Large outbound transfer ($(network.bytes) bytes) from internal host $(source.ip) — possible ePHI exfiltration</description>
    <mitre><id>T1048</id></mitre>
    <group>data_exfiltration,large_transfer,network_anomaly,hipaa_164_312_e,</group>
  </rule>

  <!-- Lateral movement — internal host scanning internal subnet -->
  <rule id="100730" level="12">
    <if_group>firewall</if_group>
    <field name="source.ip" type="pcre2">10\.|172\.(1[6-9]|2[0-9]|3[01])\.|192\.168\.</field>
    <field name="destination.ip" type="pcre2">10\.|172\.(1[6-9]|2[0-9]|3[01])\.|192\.168\.</field>
    <field name="event.action">deny|reject</field>
    <same_source_ip/>
    <frequency>15</frequency>
    <timeframe>120</timeframe>
    <description>Network Anomaly: Lateral movement — internal host $(source.ip) scanning internal subnet ($(frequency) denied in $(timeframe)s)</description>
    <mitre><id>T1021</id></mitre>
    <group>lateral_movement,network_anomaly,</group>
  </rule>

</group>
