# =============================================================================
# HIE SIEM Environment Variables — EXAMPLE
# Copy to .env and fill in real values before running
# NEVER commit .env to version control
# Use AWS Secrets Manager or Azure Key Vault in production
# =============================================================================

# OpenSearch / Wazuh Indexer
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=CHANGE_ME_strong_password_min_16_chars
OPENSEARCH_HEAP=4g

# Wazuh Dashboard
DASHBOARD_USER=kibanaserver
DASHBOARD_PASSWORD=CHANGE_ME_strong_password_min_16_chars

# Wazuh API
API_USER=wazuh-wui
API_PASSWORD=CHANGE_ME_strong_password_min_16_chars

# Wazuh Cluster key (must be 32 chars exactly)
WAZUH_CLUSTER_KEY=CHANGE_ME_32_char_cluster_key_here

# Azure Event Hub (for Azure log ingestion)
AZURE_EVENT_HUB_CONNECTION_STRING=Endpoint=sb://...

# Azure Storage (for Logstash consumer group offset tracking)
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;...

# Alert webhook (Slack, Teams, PagerDuty)
ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...

# AWS — no keys needed if using IAM roles (recommended)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Use IAM instance profiles instead
